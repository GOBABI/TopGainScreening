# 로컬 실행용 환경변수 예시 파일
# 이 파일을 복사해 .env 로 저장하고 실제 값을 채워넣으세요.
#   cp .env.example .env
# .env는 .gitignore에 등록되어 있어 깃에 올라가지 않습니다.

# GitHub watchlist/archive 동기화 + GitHub Pages 배포에 필요
GITHUB_TOKEN=

# Telegram 봇 토큰 (미설정 시 html_report.py의 하드코딩 값 사용 — 필요 시 직접 설정해 덮어쓰기)
# BOT_TOKEN=

# 한국투자증권(KIS) API — /kr 명령에 필요
KIS_APP_KEY=
KIS_APP_SECRET=

# 토스증권 Open API — /watch, /confirmsell 명령에 필요
TOSS_CLIENT_ID=
TOSS_CLIENT_SECRET=
TOSS_ACCOUNT_ID=
# false로 바꾸기 전까지는 항상 모의 주문(dry-run)만 실행됨
TOSS_DRY_RUN=true
